{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unicorn.local/schemas/unicorn-agent-trace-v1.json",
  "title": "Unicorn Agent Trace Event V1",
  "$comment": "Trace data must never contain provider API keys or authorization headers.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trace_id",
    "turn_id",
    "iteration",
    "sequence",
    "timestamp",
    "elapsed_ms",
    "event",
    "data"
  ],
  "properties": {
    "schema_version": {
      "const": "unicorn_agent_trace_v1"
    },
    "trace_id": {
      "type": "string",
      "pattern": "^trace_[A-Za-z0-9._-]+$"
    },
    "turn_id": {
      "type": "string",
      "pattern": "^turn_[A-Za-z0-9._-]+$"
    },
    "iteration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0
    },
    "event": {
      "type": "string",
      "enum": [
        "turn_received",
        "turn_validated",
        "context_built",
        "iteration_started",
        "provider_input_created",
        "provider_request_mapped",
        "provider_http_started",
        "provider_http_completed",
        "provider_output_extracted",
        "provider_response_normalized",
        "tool_call_validated",
        "tool_execution_started",
        "tool_execution_completed",
        "tool_result_reinjected",
        "iteration_completed",
        "iteration_limit_reached",
        "turn_completed",
        "turn_failed"
      ]
    },
    "data": {
      "type": "object"
    }
  },
  "examples": [
    {
      "schema_version": "unicorn_agent_trace_v1",
      "trace_id": "trace_example_001",
      "turn_id": "turn_example_001",
      "iteration": 0,
      "sequence": 4,
      "timestamp": "2026-07-27T10:00:00Z",
      "elapsed_ms": 123,
      "event": "provider_request_mapped",
      "data": {
        "provider": "local_openai_compat",
        "model": "example-model"
      }
    }
  ]
}
